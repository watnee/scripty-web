{
  "id": null,
  "uid": "scripty-domain",
  "title": "Scripty — Domain",
  "description": "Whether the product works, as opposed to whether the JVM is alive. Every panel here is backed by a scripty_* metric from ScriptyMetrics, and every alert in observability/prometheus/alerts.yml under scripty-domain or scripty-scheduled-tasks has a panel here to look at when it fires.",
  "tags": ["scripty"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Exports & imports",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 1,
      "title": "Exports per second, by format",
      "description": "Throughput, not health — read it next to the failure panel. A flat zero here during normal traffic means the export routes are unreachable, which no HTTP check would show.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (format) (rate(scripty_export_seconds_count{job=\"scripty\"}[5m]))",
          "legendFormat": "{{format}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Export failure rate",
      "description": "The ScriptyExportsFailing alert fires above 10% for 10m (the red threshold). Split by format so a single broken exporter is visible rather than averaged away.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (format) (rate(scripty_export_seconds_count{job=\"scripty\",outcome=\"failure\"}[15m]))\n  /\nclamp_min(sum by (format) (rate(scripty_export_seconds_count{job=\"scripty\"}[15m])), 0.0001)",
          "legendFormat": "{{format}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Export latency p95, by format",
      "description": "Needs the histogram enabled for scripty.export in application.yml. PDF is legitimately the slowest; a step change in one format is the signal, not the absolute value.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, format) (rate(scripty_export_seconds_bucket{job=\"scripty\"}[5m])))",
          "legendFormat": "{{format}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Imports per second, by format and outcome",
      "description": "A failed import is usually a file the parser could not read — a user error, not an incident. Watch for one format's failures going to 100%, which means the parser broke rather than the uploads did.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (format, outcome) (rate(scripty_import_seconds_count{job=\"scripty\"}[5m]))",
          "legendFormat": "{{format}} — {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Import latency p95, by format",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, format) (rate(scripty_import_seconds_bucket{job=\"scripty\"}[5m])))",
          "legendFormat": "{{format}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Email, sign-in, errors",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Outbound email, by transport and outcome",
      "description": "Password resets and invitations both ride this. transport=disabled means no transport is configured at all, which drops mail silently with no exception anywhere — worth noticing even though it is tagged a success.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (transport, outcome) (increase(scripty_email_sent_total{job=\"scripty\"}[15m]))",
          "legendFormat": "{{transport}} — {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Sign-in events",
      "description": "A failure line that climbs while success stays flat is credential stuffing, not users forgetting passwords — that is what ScriptyLoginFailureSpike watches for.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (event) (increase(scripty_auth_events_total{job=\"scripty\"}[10m]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Unhandled exceptions, by type",
      "description": "Only exceptions escaping a controller. Status separates the 500s that need attention from routine 4xx; find the stack trace by matching request_id in the Railway logs.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (exception, status) (increase(scripty_errors_unhandled_total{job=\"scripty\"}[10m]))",
          "legendFormat": "{{exception}} ({{status}})"
        }
      ]
    },
    {
      "type": "row",
      "id": 102,
      "title": "Scheduled tasks",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 9,
      "title": "Time since last successful run",
      "description": "The nightly purge jobs are the only code here with no user to notice it broke. Green under 25h is a normal nightly cadence; red at 36h is where ScriptyScheduledTaskStale fires. A task missing from this panel entirely has not succeeded since the last restart — the gauge is not registered until a task's first success, so a fresh deploy shows nothing here until roughly 03:45.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 90000 },
              { "color": "red", "value": 129600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - scripty_scheduled_task_last_success_timestamp_seconds{job=\"scripty\"}",
          "legendFormat": "{{task}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Scheduled task runs (24h)",
      "description": "One bar per run. Nothing at all for a task means it did not fire; a failure bar means it fired and threw. The purge jobs are idempotent, so a single failure is not data loss — it just means trash sits for another day.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (task, outcome) (increase(scripty_scheduled_task_seconds_count{job=\"scripty\"}[1h]))",
          "legendFormat": "{{task}} — {{outcome}}"
        }
      ]
    }
  ]
}
